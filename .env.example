# ==========================================
# FLOW FINANCE - VARIÁVEIS DE AMBIENTE
# ==========================================

# --- Front-End (Vite) ---
# URL pública do projeto Supabase
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
# Chave pública/anon do Supabase (para operações client-side com RLS)
VITE_SUPABASE_ANON_KEY=sua_anon_public_key_aqui

# --- Back-End (Vercel Serverless Functions) ---
# URL do Supabase para funções serverless
SUPABASE_URL=https://seu-projeto.supabase.co
# Chave de serviço com privilégios administrativos (usada no cron e webhooks)
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# --- Integração Asaas (Pagamentos e Cobranças) ---
# Chave de API da conta Asaas
ASAAS_API_KEY=sua_asaas_api_key_aqui
# URL da API Asaas (Produção: https://www.asaas.com/api/v3 | Sandbox: https://sandbox.asaas.com/api/v3)
ASAAS_API_URL=https://www.asaas.com/api/v3
# Token secreto para validação das requisições de Webhook do Asaas
ASAAS_WEBHOOK_TOKEN=seu_webhook_secret_token_aqui

# --- Web Push Notifications (VAPID) ---
# Chave pública VAPID
VAPID_PUBLIC_KEY=sua_vapid_public_key_aqui
# Chave privada VAPID (usada pelo cron check_bills)
VAPID_PRIVATE_KEY=sua_vapid_private_key_aqui
# Contato de identificação para o serviço de push (mailto:...)
VAPID_SUBJECT=mailto:seu_email@exemplo.com
